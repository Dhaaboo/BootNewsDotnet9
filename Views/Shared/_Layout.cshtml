@{
    var categories = ViewBag.Categories as List<BootNews.Models.Category> ?? new();
    var breaking = ViewBag.Breaking as List<BootNews.Models.Article> ?? new();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "BootNews") - BootNews Magazine</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- TOPBAR -->
    <div class="topbar">
        <div class="container topbar-inner">
            <div class="topbar-left">
                <span class="topbar-date">@DateTime.Now.ToString("dddd, MMM dd, yyyy")</span>
                <a href="/">Home</a>
                <a href="/Page/About">About Us</a>
                <a href="/Page/Contact">Contact Us</a>
                <a href="#" class="buy-now">Buy Now</a>
            </div>
            <div class="topbar-social">
                <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                <a href="#" aria-label="Youtube"><i class="fab fa-youtube"></i></a>
                <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                <a href="#" aria-label="Vimeo"><i class="fab fa-vimeo-v"></i></a>
            </div>
        </div>
    </div>

    <!-- LOGO + AD -->
    <div class="container logo-row">
        <a class="logo" href="/">b<span class="logo-oo">oo</span>tnews</a>
        <div class="ad-banner">
            <span class="ad-size">728&times;90</span>
            <span class="ad-text">ADVERTISEMENT</span>
        </div>
        <button class="nav-toggle" id="navToggle" aria-label="Menu"><i class="fas fa-bars"></i></button>
    </div>

    <!-- MAIN NAV -->
    <nav class="main-nav" id="mainNav">
        <div class="container nav-inner">
            <ul class="nav-links">
                <li><a href="/" class="active">Home</a></li>
                @foreach (var c in categories)
                {
                    <li><a href="/Category/@c.Slug">@c.Name</a></li>
                }
            </ul>
            <form class="nav-search" action="/Home/Search" method="get">
                <input type="text" name="q" placeholder="Search news..." />
                <button type="submit" aria-label="Search"><i class="fas fa-search"></i></button>
            </form>
        </div>
    </nav>

    <!-- BREAKING NEWS TICKER -->
    @if (breaking.Any())
    {
        <div class="container breaking-bar">
            <span class="breaking-label"><i class="fas fa-bolt"></i> Breaking news</span>
            <div class="breaking-ticker" id="breakingTicker">
                @foreach (var b in breaking)
                {
                    <a class="breaking-item" href="/Article/@b.Id/@b.Slug">@b.Title</a>
                }
            </div>
            <div class="breaking-arrows">
                <button id="breakPrev" aria-label="Previous"><i class="fas fa-chevron-left"></i></button>
                <button id="breakNext" aria-label="Next"><i class="fas fa-chevron-right"></i></button>
            </div>
        </div>
    }

    <main class="container main-content">
        @RenderBody()
    </main>

    <!-- NEWSLETTER -->
    <section class="newsletter">
        <div class="container newsletter-inner">
            <div>
                <h3>Get Updates</h3>
                <p>Subscribe our newsletter to get the last update into your inbox!</p>
            </div>
            <form class="newsletter-form" action="#" method="post">
                <input type="email" placeholder="Please insert email address." required />
                <button type="submit">Subscribe</button>
            </form>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="site-footer">
        <div class="container footer-inner">
            <a class="logo logo-footer" href="/">b<span class="logo-oo">oo</span>tnews</a>
            <ul class="footer-links">
                <li><a href="/">Home</a></li>
                @foreach (var c in categories)
                {
                    <li><a href="/Category/@c.Slug">@c.Name</a></li>
                }
            </ul>
            <div class="topbar-social footer-social">
                <a href="#"><i class="fab fa-facebook-f"></i></a>
                <a href="#"><i class="fab fa-twitter"></i></a>
                <a href="#"><i class="fab fa-youtube"></i></a>
                <a href="#"><i class="fab fa-instagram"></i></a>
                <a href="#"><i class="fab fa-vimeo-v"></i></a>
            </div>
            <p class="copyright">Copyright &copy; Bootnews - All rights reserved</p>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
